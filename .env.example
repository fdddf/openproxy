# Copy to .env — docker compose reads it automatically.

# Host port the proxy is published on.
OPENPROXY_PORT=8081

# Leave empty to have a key generated and persisted on first start. Pin it to
# keep issued sessions valid across a database reset:
#   openssl rand -hex 32
JWT_SIGN_KEY=

# "sqlite" (default, no second container) or "postgres".
DB_DRIVER=sqlite

# Only used when DB_DRIVER=postgres. DB_PASSWORD is required by that profile.
DB_HOST=postgres
DB_PORT=5432
DB_USER=openproxy
DB_PASSWORD=
DB_NAME=openproxy
DB_SSL_MODE=disable
